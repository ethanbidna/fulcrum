{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/workspace/type-contracts.ts",
    "apps/**/*.tsx"
  ]
}
