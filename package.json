{
  "name": "fulcrum",
  "private": true,
  "description": "Local-first initiative organizer for macOS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "npm run test:reference && vitest run --project unit",
    "test:reference": "node --test \"tools/test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tools/workspace",
    "schema:generate": "node tools/workspace/generate-schema.mjs",
    "schema:check": "node tools/workspace/generate-schema.mjs --check",
    "check": "npm run schema:check && npm run lint && npm run typecheck && npm test",
    "dev": "node tools/dev-shell.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 127.0.0.1 --port 6007 --ci",
    "storybook:tools": "STORYBOOK_DISABLE_TELEMETRY=1 storybook tools",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "test:ui": "STORYBOOK_DISABLE_TELEMETRY=1 storybook tools test run",
    "typecheck:ui": "tsc --project .storybook/tsconfig.json",
    "check:ui": "npm run typecheck:ui && npm run test:ui && npm run build-storybook"
  },
  "devDependencies": {
    "@fulcrum/schema": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@storybook/addon-a11y": "11.0.0-beta.1",
    "@storybook/addon-docs": "11.0.0-beta.1",
    "@storybook/addon-vitest": "11.0.0-beta.1",
    "@storybook/react-vite": "11.0.0-beta.1",
    "@types/node": "22.15.29",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "11.0.0-beta.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.11.0"
}
