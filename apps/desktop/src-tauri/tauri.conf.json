{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fulcrum",
  "version": "0.1.0",
  "identifier": "org.fulcrum.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Fulcrum", "width": 1200, "height": 800, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["../../../spikes/s7/src-tauri/icons/icon.icns", "../../../spikes/s7/src-tauri/icons/icon.png"], "macOS": { "minimumSystemVersion": "13.0" } }
}
