{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fulcrum S7",
  "version": "0.1.0",
  "identifier": "org.example.fulcrum.s7",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Fulcrum packaging probe", "width": 640, "height": 360 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "externalBin": ["binaries/fulcrum-core"], "icon": ["icons/icon.icns", "icons/icon.png"], "macOS": { "minimumSystemVersion": "13.0", "entitlements": "Entitlements.plist" } }
}
